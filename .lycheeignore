# Patterns of URLs lychee should skip during link checks.
# One regex per line. Lines starting with # are ignored.

# Gemini's homepage fails HTTP/2 negotiation against CI runners, which
# produces a transport error rather than a status code, so --accept cannot
# cover it. The badge link resolves fine in a browser.
^https://gemini\.google\.com

# Placeholder links in code-block examples.
example\.com
